# InfoShield Flask Backend Environment Variables
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
SECRET_KEY=infoshield-super-secret-key-change-in-production-2026
JWT_SECRET_KEY=infoshield-jwt-token-secret-civic-defense-2026
JWT_EXPIRATION_HOURS=24

# Database Engine: 'mysql' (default) or 'sqlite' (for zero-setup dev/test)
DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=infoshield_db

# Optional Groq Cloud LPU AI Integration (for Qwen 3.8 / Llama 3 on Groq)
GROQ_API_KEY=your_groq_api_key_here
